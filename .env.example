# ============================================================================
# Environment configuration — copy this file to ".env" and fill in real values.
# Never commit the real ".env" file.
# ============================================================================

# --- Database -----------------------------------------------------------
# Zero-setup local development uses a SQLite file (no install required).
# For a "production-like" run, start Postgres via `docker-compose up -d db`
# and switch DATABASE_URL to the Postgres URL below.
DATABASE_URL=sqlite:///./keystroke_auth.db
# DATABASE_URL=postgresql+psycopg://keystroke_user:keystroke_pass@localhost:5432/keystroke_auth

# --- Auth / JWT -----------------------------------------------------------
# Generate a real secret with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-random-64-character-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Keystroke enrollment ---------------------------------------------------
# Fixed phrase every user types during enrollment and login verification.
AUTH_PHRASE=My secure typing pattern is unique.
# Minimum number of enrollment samples required before a typing profile
# is considered "ready" and used for authentication.
MIN_ENROLLMENT_SAMPLES=8
# Minimum number of *other* users (each with enough samples) required
# before a personal ML classifier can be trained (it needs impostor data).
MIN_OTHER_USERS_FOR_ML=1
# Minimum samples an "other user" must contribute to count as impostor data.
MIN_IMPOSTOR_SAMPLES_PER_USER=5

# --- Authentication decision thresholds ------------------------------------
# Similarity score (0-1) at/above which the typing pattern is considered a
# match. See docs/09_Model_Evaluation.md for how this value was chosen.
VERIFICATION_MATCH_THRESHOLD=0.60
# Score below which risk is reported as HIGH (between this and the match
# threshold, risk is reported as MEDIUM).
VERIFICATION_SUSPICIOUS_THRESHOLD=0.40
# "strict": typing mismatch fails authentication outright (recommended for
#           demonstrating the system's behavioral-factor value).
# "advisory": typing mismatch is logged/flagged but does not by itself fail
#           a request with a correct password (safer default for a small,
#           early-stage enrolled profile — see docs/12_Limitations.md).
AUTH_ENFORCEMENT_MODE=strict

# --- CORS -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Misc ---------------------------------------------------------------
ENVIRONMENT=development
